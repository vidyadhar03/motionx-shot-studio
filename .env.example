# Copy to .env (gitignored). Never commit a real key.
# fake = no network, no spend (default). comfy_local = SDK -> comfy-api-proxy -> local ComfyUI -> H3 Partner Node.
STUDIO_ADAPTER=fake
# Workspace: by default your projects live in one per-user folder (macOS: ~/Library/Application Support/
# MotionX Shot Studio/workspace). Leave STUDIO_DATA_DIR unset for everyday use; set it only for an isolated
# test/rehearsal workspace (the app then shows ISOLATED WORKSPACE).
# STUDIO_DATA_DIR=
COMFY_BASE_URL=http://127.0.0.1:8189
COMFYUI_URL=http://127.0.0.1:8188
# Partner Node key from https://platform.comfy.org/profile/api-keys (starts with comfyui-)
COMFY_API_KEY=
# Hard application limits on paid video (reserved at approval, observed via balance delta).
# Both default to 0, which disables paid generation. Raise them deliberately.
STUDIO_BUDGET_CREDITS=0
STUDIO_MAX_PAID_ATTEMPTS=0
# Separate limits on paid IMAGE generation for assets (M6, Seedream 5.0 Flash ~5.43 credits/image). 0 disables it.
STUDIO_IMAGE_BUDGET_CREDITS=0
STUDIO_IMAGE_MAX_PAID_ATTEMPTS=0

# -- Agent (M3). Scripted = deterministic rule-based stand-in, no LLM, no network (development default).
# Live providers: gemini (default live) | anthropic. No automatic fallback between providers.
STUDIO_AGENT_PROVIDER=scripted
# Empty = provider default: gemini-3.8-flash / claude-opus-5-5. Verified against the provider before first live call.
STUDIO_AGENT_MODEL=
STUDIO_AGENT_MAX_TURNS=12
STUDIO_AGENT_MAX_OUTPUT_TOKENS=8000
STUDIO_AGENT_THINKING=low
# LLM spend cap in USD, separate from Comfy credits. 0 blocks every live LLM call.
STUDIO_AGENT_BUDGET_USD=0
# Hard cap on the total number of live model requests ever made (0 blocks live calls).
STUDIO_AGENT_MAX_LIVE_REQUESTS=0
# Thinking tokens assumed per request in the pre-call estimate (an estimate, not a bound).
STUDIO_AGENT_THOUGHT_ALLOWANCE=8192
GEMINI_API_KEY=
# Or Gemini on Vertex AI with Application Default Credentials:
STUDIO_GEMINI_VERTEX_PROJECT=
ANTHROPIC_API_KEY=
