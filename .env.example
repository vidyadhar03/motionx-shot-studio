# Copy to .env (gitignored). Never commit a real key.
# fake = no network, no spend (default). comfy_local = SDK -> comfy-api-proxy -> local ComfyUI -> H3 Partner Node.
STUDIO_ADAPTER=fake
# Workspace: by default your projects live in one per-user folder (macOS: ~/Library/Application Support/
# MotionX Shot Studio/workspace). Leave STUDIO_DATA_DIR unset for everyday use; set it only for an isolated
# test/rehearsal workspace (the app then shows ISOLATED WORKSPACE).
# STUDIO_DATA_DIR=
COMFY_BASE_URL=http://127.0.0.1:8189
COMFYUI_URL=http://127.0.0.1:8188
# With comfy_local, ./scripts/run_app.sh reuses or starts local ComfyUI + proxy (never restarts a healthy one).
# Set to 0 to manage them yourself; the app then only reports what it finds.
# STUDIO_MANAGE_SERVICES=1
# Partner Node key from https://platform.comfy.org/profile/api-keys (starts with comfyui-)
COMFY_API_KEY=
# Paid video and image generation always needs a person to approve each concrete proposal (one approval = one
# submission at the cost shown). The OPTIONAL overall limits below are unset by default (no overall limit). They can be
# set in the app's Settings instead; a value set here wins over Settings and shows there as read-only. An explicit 0
# locks that kind of spending.
# STUDIO_BUDGET_CREDITS=
# STUDIO_MAX_PAID_ATTEMPTS=
# STUDIO_IMAGE_BUDGET_CREDITS=
# STUDIO_IMAGE_MAX_PAID_ATTEMPTS=

# -- Agent (M3). Unset: gemini when a Gemini key is configured, otherwise the scripted stand-in (rule-based, no LLM, no
# network). Other values: anthropic | replay. No automatic fallback between providers.
# STUDIO_AGENT_PROVIDER=
# Empty = provider default: gemini-3.8-flash / claude-opus-5-5. Verified against the provider before first live call.
STUDIO_AGENT_MODEL=
# Model requests per message (also editable in Settings). A safeguard that resets with every message you send.
# STUDIO_AGENT_MAX_TURNS=12
STUDIO_AGENT_MAX_OUTPUT_TOKENS=8000
STUDIO_AGENT_THINKING=low
# OPTIONAL dollar limit on live LLM spend, separate from Comfy credits. Unset = no dollar limit (usage is still counted).
# 0 blocks every live LLM call.
# STUDIO_AGENT_BUDGET_USD=
# Live model requests allowed in ONE conversation (default 60; a new conversation starts fresh). 0 blocks live calls.
# STUDIO_AGENT_MAX_LIVE_REQUESTS=60
# Thinking tokens assumed per request in the pre-call estimate (an estimate, not a bound).
STUDIO_AGENT_THOUGHT_ALLOWANCE=8192
GEMINI_API_KEY=
# Or Gemini on Vertex AI with Application Default Credentials:
STUDIO_GEMINI_VERTEX_PROJECT=
ANTHROPIC_API_KEY=
